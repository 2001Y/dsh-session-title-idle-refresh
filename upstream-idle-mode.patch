diff --git a/packages/session/session-title/tests/idle.spec.ts b/packages/session/session-title/tests/idle.spec.ts
new file mode 100644
index 00000000..8691ee43
--- /dev/null
+++ b/packages/session/session-title/tests/idle.spec.ts
@@ -0,0 +1,135 @@
+import AgentRegistry from '@deepseek-ai/dsh-agent'
+import { Context } from '@deepseek-ai/cordis'
+import Timer from '@deepseek-ai/cordis-plugin-timer'
+import { describe, expect, it, onTestFinished, vi } from 'vitest'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import SessionStore, { SessionId } from '@deepseek-ai/dsh-session'
+import SessionProjectionRegistry from '@deepseek-ai/dsh-session-projection'
+import SessionTitleService, {
+  SessionTitleProviderId,
+  type SessionTitleProvider,
+  type SessionTitleUserMessage,
+} from '@deepseek-ai/dsh-session-title'
+
+const CONFIG = {
+  fallbackMaxWords: 5,
+  fallbackMaxBytes: 24,
+  maxTitleBytes: 24,
+  idleRefreshMs: 60,
+  idleScanMs: 10,
+} as const
+
+async function settle(ms = 0): Promise<void> {
+  await new Promise(resolve => setTimeout(resolve, ms))
+}
+
+async function waitUntil(predicate: () => boolean, timeoutMs = 3000): Promise<void> {
+  const deadline = Date.now() + timeoutMs
+  while (!predicate()) {
+    if (Date.now() > deadline) throw new Error('waitUntil timed out')
+    await settle(10)
+  }
+}
+
+function appendHumanPrompt(session: ReturnType<Context['sessions']['create']>, text: string) {
+  return session.append('user/message', createUserMessage({
+    content: [{ type: 'text', text }],
+    source: { kind: 'user' },
+  }), { surfaceOp: 'append' })
+}
+
+function appendRoute(session: ReturnType<Context['sessions']['create']>): void {
+  session.append('request/header', {
+    header: { config: { provider: 'main-route', model: 'chat-model' } },
+    reason: 'initial',
+  })
+}
+
+async function createContext(withTimer: boolean): Promise<Context> {
+  const ctx = new Context()
+  onTestFinished(() => ctx.fiber.dispose())
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SessionProjectionRegistry)
+  await ctx.plugin(AgentRegistry)
+  // The title service looks the timer up when it initializes, so the
+  // timer plugin must be in place first — as it is in profile hosts.
+  if (withTimer) await ctx.plugin(Timer)
+  await ctx.plugin(SessionTitleService, CONFIG)
+  return ctx
+}
+
+function registerIdleProvider(ctx: Context): ReturnType<typeof vi.fn> {
+  const generate = vi.fn<SessionTitleProvider['generate']>(async request => ({
+    title: `T${request.messages.length}`,
+    messageSeqs: request.messages.map(message => message.seq),
+  }))
+  ctx.sessionTitle.register({ id: SessionTitleProviderId('idle-fake'), automatic: 'idle', generate })
+  return generate
+}
+
+describe('SessionTitleService idle mode', () => {
+  it('titles once on the first prompt, stays quiet on later prompts, and refreshes after the idle window', async () => {
+    const ctx = await createContext(true)
+    const generate = registerIdleProvider(ctx)
+    const session = ctx.sessions.create(SessionId('idle-main'))
+
+    appendHumanPrompt(session, 'First topic alpha')
+    appendRoute(session)
+    await waitUntil(() => generate.mock.calls.length === 1)
+    await waitUntil(() => ctx.sessionTitle.get(session)?.title === 'T1')
+
+    // A second prompt must not schedule generation in idle mode.
+    appendHumanPrompt(session, 'Second topic beta')
+    appendRoute(session)
+    await settle(50)
+    expect(generate).toHaveBeenCalledTimes(1)
+    expect(ctx.sessionTitle.get(session)?.title).toBe('T1')
+
+    // Once the session has been idle past idleRefreshMs, the sweep
+    // regenerates from all messages and the title catches up.
+    await waitUntil(() => generate.mock.calls.length === 2)
+    await waitUntil(() => ctx.sessionTitle.get(session)?.title === 'T2')
+    expect(generate.mock.calls[1]?.[0].messages.map((message: SessionTitleUserMessage) => message.text)).toEqual([
+      'First topic alpha',
+      'Second topic beta',
+    ])
+
+    // The title now covers the latest message: no further attempts.
+    await settle(200)
+    expect(generate).toHaveBeenCalledTimes(2)
+  })
+
+  it('never refreshes a user-pinned title', async () => {
+    const ctx = await createContext(true)
+    const generate = registerIdleProvider(ctx)
+    const session = ctx.sessions.create(SessionId('idle-pinned'))
+
+    appendHumanPrompt(session, 'First topic alpha')
+    appendRoute(session)
+    await waitUntil(() => ctx.sessionTitle.get(session)?.title === 'T1')
+
+    ctx.sessionTitle.rename(session, 'Mine')
+    appendHumanPrompt(session, 'Second topic beta')
+    appendRoute(session)
+    await settle(250)
+    expect(generate).toHaveBeenCalledTimes(1)
+    expect(ctx.sessionTitle.get(session)?.title).toBe('Mine')
+    expect(ctx.sessionTitle.get(session)?.source.kind).toBe('user')
+  })
+
+  it('without a timer service, an idle provider titles initially and never sweeps', async () => {
+    const ctx = await createContext(false)
+    const generate = registerIdleProvider(ctx)
+    const session = ctx.sessions.create(SessionId('idle-no-timer'))
+
+    appendHumanPrompt(session, 'First topic alpha')
+    appendRoute(session)
+    await waitUntil(() => ctx.sessionTitle.get(session)?.title === 'T1')
+
+    appendHumanPrompt(session, 'Second topic beta')
+    appendRoute(session)
+    await settle(250)
+    expect(generate).toHaveBeenCalledTimes(1)
+    expect(ctx.sessionTitle.get(session)?.title).toBe('T1')
+  })
+})
